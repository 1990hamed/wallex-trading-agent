# Copy this file to .env and fill in secrets locally. Never commit .env.
OPENAI_API_KEY= # کلید اختیاری OpenAI؛ در صورت وجود BoxAPI اولویت دارد
BOXAPI_API_KEY= # کلید API سرویس BoxAPI
BOXAPI_API_URL_BASE=https://ai.boxapi.ir/ai/v1 # آدرس سازگار با OpenAI برای BoxAPI
WALLEX_API_KEY= # کلید API والکس
MCP_SERVER_URL=https://api.wallex.ir/mcp # آدرس MCP رسمی والکس
AI_MODEL=gpt-5-mini # نام مدل زبانی
TRADING_MODE=shadow # حالت اجرا: shadow یا live
ENABLE_LIVE_TRADING=false # قفل دوم ارسال سفارش واقعی
SYMBOL=BTCTMN # نماد Spot مورد معامله
CANDLE_RESOLUTION=60 # بازه هر کندل برحسب دقیقه
CANDLE_COUNT=120 # تعداد کندل‌های تاریخی
POLL_INTERVAL_SECONDS=300 # فاصله اجرای چرخه‌ها برحسب ثانیه
RISK_PER_TRADE=0.005 # حداکثر ریسک هر معامله، ۰.۵ درصد سرمایه
INITIAL_CAPITAL_TMN=5000000 # سرمایه مبنا برای ارزیابی، تومان
MAX_POSITION_FRACTION=0.10 # سقف تخصیص سرمایه به یک موقعیت
MAX_DAILY_LOSS_FRACTION=0.02 # سقف زیان روزانه مجاز
STOP_LOSS_ATR=1.5 # فاصله حدضرر برحسب ضریب ATR
TAKE_PROFIT_ATR=2.5 # فاصله حدسود برحسب ضریب ATR
DECISION_LOG_PATH=data/decision_log.jsonl # مسیر لاگ تصمیم‌ها
