# Copy this file to .env and fill in secrets locally. Never commit .env.
OPENAI_API_KEY= # Optional OpenAI API key; BoxAPI takes priority
BOXAPI_API_KEY= # BoxAPI service API key
BOXAPI_API_URL_BASE=https://ai.boxapi.ir/ai/v1 # OpenAI-compatible BoxAPI base URL
WALLEX_API_KEY= # Wallex API key
MCP_SERVER_URL=https://api.wallex.ir/mcp # Official Wallex MCP URL
AI_MODEL=gpt-5-mini # Language model name
TRADING_MODE=shadow # Execution mode: shadow or live
ENABLE_LIVE_TRADING=false # Second safety gate for real orders
SYMBOL=BTCTMN # Spot market symbol
CANDLE_RESOLUTION=60 # Candle interval in minutes
CANDLE_COUNT=120 # Number of historical candles
POLL_INTERVAL_SECONDS=300 # Cycle interval in seconds
RISK_PER_TRADE=0.005 # Maximum risk per trade: 0.5 percent
INITIAL_CAPITAL_TMN=5000000 # Benchmark capital for evaluation in TMN
MAX_POSITION_FRACTION=0.10 # Maximum capital allocation per position
MAX_DAILY_LOSS_FRACTION=0.02 # Maximum permitted daily loss
STOP_LOSS_ATR=1.5 # Stop-loss distance as an ATR multiple
TAKE_PROFIT_ATR=2.5 # Take-profit distance as an ATR multiple
DECISION_LOG_PATH=data/decision_log.jsonl # Decision log file path
BACKTEST_LOG_PATH=data/backtest_log.jsonl # Backtest log file path
TRADING_END_TIME= # Optional ISO-8601 Tehran time for forced Spot liquidation
LIQUIDATION_BUFFER_MINUTES=30 # Stop opening new positions before the end time
