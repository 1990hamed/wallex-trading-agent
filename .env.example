# Copy this file to .env and fill in secrets locally. Never commit .env.
OPENAI_API_KEY=
BOXAPI_API_KEY=
BOXAPI_API_URL_BASE=https://ai.boxapi.ir/ai/v1
WALLEX_API_KEY=
MCP_SERVER_URL=https://api.wallex.ir/mcp
AI_MODEL=gpt-5-mini
TRADING_MODE=shadow
ENABLE_LIVE_TRADING=false
SYMBOL=BTCTMN
CANDLE_RESOLUTION=60
CANDLE_COUNT=120
POLL_INTERVAL_SECONDS=300
RISK_PER_TRADE=0.005
INITIAL_CAPITAL_TMN=5000000
MAX_POSITION_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.02
STOP_LOSS_ATR=1.5
TAKE_PROFIT_ATR=2.5
DECISION_LOG_PATH=data/decision_log.jsonl
